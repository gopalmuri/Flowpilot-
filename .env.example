# ==============================================================================
# FlowPilot Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values according to your environment.
# DO NOT commit real secrets or credentials to source control.

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="FlowPilot"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="change-me-in-production-use-a-strong-random-secret-key-32-chars-min"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef" # 32-byte hex key for credential encryption
ALLOWED_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16+)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=flowpilot
POSTGRES_USER=flowpilot_admin
POSTGRES_PASSWORD=flowpilot_secret_password
DATABASE_URL="postgresql+asyncpg://flowpilot_admin:flowpilot_secret_password@postgres:5432/flowpilot"
SYNC_DATABASE_URL="postgresql://flowpilot_admin:flowpilot_secret_password@postgres:5432/flowpilot"

# ------------------------------------------------------------------------------
# Redis & Background Workers (Celery)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"
CELERY_TASK_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET="change-this-jwt-signing-secret-with-openssl-rand-hex-32"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_SCHEME="argon2"      # argon2 | bcrypt

# ------------------------------------------------------------------------------
# AI Provider Abstraction (OpenAI / Anthropic / Local Mock)
# ------------------------------------------------------------------------------
AI_PROVIDER="openai"               # openai | anthropic | mock
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_DEFAULT_MODEL="gpt-4o-mini"
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
AI_MAX_TOKENS=1000

# ------------------------------------------------------------------------------
# Integrations (Initial MVP: Webhook, Mock CRM, Slack)
# ------------------------------------------------------------------------------
# Webhooks
WEBHOOK_MAX_PAYLOAD_SIZE_BYTES=1048576  # 1 MB max payload
WEBHOOK_IDEMPOTENCY_TTL_SECONDS=86400   # 24 hours deduplication window

# Mock CRM Configuration
MOCK_CRM_LATENCY_MS=50
MOCK_CRM_SIMULATE_FAILURES=false

# Slack Integration (OAuth & Incoming Webhooks)
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""

# ------------------------------------------------------------------------------
# Frontend Settings (Vite / React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:8000"
VITE_APP_TITLE="FlowPilot - AI Workflow Automation"
